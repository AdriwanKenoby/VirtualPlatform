    {
      "mode": "managed",
      "type": "libvirt_cloudinit_disk",
      "name": "init",
      "provider": "provider[\"registry.terraform.io/dmacvicar/libvirt\"]",
      "instances": [
        {
          "index_key": "k8s-control-plane-1",
          "schema_version": 0,
          "attributes": {
            "id": "85252043e9780749",
            "meta_data": "\"instance-id\": \"k8s-control-plane-1\"\n\"local-hostname\": \"k8s-control-plane-1\"\n",
            "name": "k8s-control-plane-1-cloudinit",
            "network_config": "version: 2\nethernets:\n  default:\n    match:\n      driver: virtio*   # Match n'importe quelle interface virtio\n    dhcp4: false\n    dhcp6: false\n    addresses:\n      - 192.168.100.100/24\n    routes:\n      - to: default\n        via: 192.168.100.1/24\n    nameservers:\n      addresses:\n        - 192.168.1.254\n        - 8.8.8.8\n",
            "path": "/tmp/terraform-provider-libvirt-cloudinit/cloudinit-85252043e9780749.iso",
            "size": 45056,
            "user_data": "#cloud-config\n\n# Hostname de la VM\nhostname: k8s-control-plane-1\nfqdn: k8s-control-plane-1.local\nmanage_etc_hosts: true\n\n# Utilisateur par défaut\nusers:\n  - name: ubuntu\n    groups: [adm, sudo, docker]\n    shell: /bin/bash\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    lock_passwd: true  # Désactive le mot de passe (SSH key only)\n    ssh_authorized_keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL6n9YeW0YeEuFrczlzyk8CpklO52451w/y164L9h4zO adri17ve@gmail.com\n\n\n# Paquets à installer\npackages:\n  - qemu-guest-agent  # Indispensable pour récupérer l'IP\n  - curl\n  - vim\n  - htop\n\n# Activer l'agent QEMU au démarrage\nruncmd:\n  - systemctl enable --now qemu-guest-agent\n\n# Autoriser SSH par clé uniquement\nssh_pwauth: false\n\n# Mise à jour des paquets au premier boot\npackage_update: true\npackage_upgrade: false  # Évite les surprises de temps\n\n# Message final\nfinal_message: |\n  Cloud-init terminé après $UPTIME secondes.\n  Hostname: k8s-control-plane-1\n  Connectez-vous avec: ssh ubuntu@\u003cIP\u003e\n"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        },
